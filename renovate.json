{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":timezone(Europe/Berlin)"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    { "matchFileNames": ["server/**"], "addLabels": ["server"] },
    { "matchFileNames": ["web/**"], "addLabels": ["web"] },
    { "matchFileNames": [".github/**"], "addLabels": ["ci"] },
    {
      "description": "Automerge stable non-major updates once the image build passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "description": "Let new releases settle before they are proposed",
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Postgres majors need a manual pg_upgrade of the data volume",
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}